<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KHGN Training — Level 2: Copyright & Terms of Use</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rye&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --walnut:#2B211A; --walnut-deep:#1C140F; --parchment:#EDE0C8; --parchment-dim:#E0D0AC;
    --ink:#221A12; --brass:#B08D57; --brass-bright:#D4AF6A; --rust:#A63D2F; --rust-bright:#C2503F;
    --sage:#6B8A5C; --sage-bright:#82A671; --line:#4A392A;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background: radial-gradient(ellipse at 50% -10%, rgba(176,141,87,0.18), transparent 60%), var(--walnut);
    color:var(--parchment); font-family:'Public Sans', sans-serif; min-height:100vh;
    display:flex; justify-content:center; padding:28px 16px 60px;
  }
  .app{ width:100%; max-width:760px; }
  .masthead{ text-align:center; margin-bottom:18px; }
  .masthead .eyebrow{ font-size:13px; letter-spacing:0.03em; color:var(--brass-bright); margin-bottom:4px; }
  .masthead h1{
    font-family:'Rye', serif; font-weight:400; font-size:clamp(24px,5vw,34px);
    margin:0; color:var(--parchment); text-shadow:0 2px 0 var(--walnut-deep);
  }
  .masthead .level-sub{ font-size:14px; color:var(--parchment-dim); margin-top:4px; }
  .portal-link{
    display:inline-block; margin-top:12px; font-size:13px; font-weight:700;
    color:var(--walnut-deep); background:var(--brass-bright); text-decoration:none;
    padding:8px 16px; border-radius:20px; transition:background .15s ease;
  }
  .portal-link:hover{ background:var(--brass); }

  .trail-wrap{
    background:var(--walnut-deep); border:1px solid var(--line); border-radius:14px;
    padding:18px 14px 10px; margin-bottom:20px; overflow-x:auto;
  }
  .trail{ display:flex; align-items:center; min-width:640px; position:relative; padding:0 6px; }
  .trail-line{ position:absolute; left:26px; right:26px; top:15px; height:3px; background:var(--line); z-index:0; }
  .trail-line-fill{ position:absolute; left:26px; top:15px; height:3px; background:var(--brass); z-index:1; transition:width .5s ease; }
  .stop{ flex:1; display:flex; flex-direction:column; align-items:center; position:relative; z-index:2; }
  .stop-dot{
    width:32px; height:32px; border-radius:50%; background:var(--walnut);
    border:3px solid var(--line); display:flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:700; color:var(--parchment-dim); transition:all .3s ease;
  }
  .stop.done .stop-dot{ background:var(--sage); border-color:var(--sage-bright); color:var(--walnut-deep); }
  .stop.current .stop-dot{
    background:var(--brass); border-color:var(--brass-bright); color:var(--walnut-deep);
    box-shadow:0 0 0 4px rgba(176,141,87,0.25);
  }
  .stop-label{ font-size:10px; margin-top:6px; color:var(--parchment-dim); opacity:.7; }

  .card{
    background:var(--parchment); color:var(--ink); border-radius:16px; padding:28px 26px;
    box-shadow:0 10px 30px rgba(0,0,0,0.35); animation:rise .4s ease;
  }
  @keyframes rise{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }
  .card.sheriff{ background:#EAD9CE; }

  .character-row{ display:flex; gap:16px; align-items:flex-start; margin-bottom:18px; }
  .portrait{ width:76px; height:76px; flex-shrink:0; border-radius:10px; border:2px solid var(--ink); background:var(--walnut); }
  .char-meta{ flex:1; }
  .char-name{ font-family:'Rye', serif; font-size:22px; margin:0 0 2px; color:var(--ink); }
  .char-role{ font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:#6B5A42; margin:0 0 8px; }
  .narration-btn{
    display:inline-flex; align-items:center; gap:6px; background:var(--ink); color:var(--parchment);
    border:none; border-radius:20px; padding:6px 14px; font-size:12px; font-weight:600; cursor:pointer;
  }
  .narration-btn:hover{ background:#3a2c1e; }

  .body-text{ font-size:15.5px; line-height:1.6; margin:0 0 18px; }
  .scenario-box{
    background:rgba(0,0,0,0.06); border-left:4px solid var(--brass); padding:14px 16px;
    border-radius:6px; font-size:14.5px; line-height:1.55; margin-bottom:20px; font-style:italic;
  }
  .gotcha-badge{
    display:inline-block; background:var(--rust); color:#fff; font-size:10px; font-weight:700;
    letter-spacing:.04em; padding:3px 9px; border-radius:12px; margin-bottom:8px;
  }

  .primary-btn{
    background:var(--rust); color:#fff; border:none; border-radius:10px; padding:13px 22px;
    font-size:15px; font-weight:700; cursor:pointer; width:100%; transition:background .15s ease;
  }
  .primary-btn:hover{ background:var(--rust-bright); }
  .primary-btn:disabled{
    background:var(--walnut-deep); color:var(--brass-bright); opacity:1; cursor:not-allowed;
    border:1px solid var(--brass);
  }
  .secondary-btn{
    background:transparent; color:var(--ink); border:2px solid var(--ink); border-radius:10px;
    padding:11px 20px; font-size:14px; font-weight:700; cursor:pointer; width:100%; margin-top:10px;
  }

  .question-block{ margin-bottom:20px; }
  .q-num{ font-size:12px; font-weight:700; color:var(--rust); letter-spacing:.03em; margin-bottom:6px; }
  .q-prompt{ font-size:15px; font-weight:600; margin:0 0 10px; }
  .options{ display:flex; flex-direction:column; gap:8px; }
  .option{
    text-align:left; background:#fff; border:2px solid #D8C7A3; border-radius:8px; padding:11px 14px;
    font-size:14.5px; font-family:inherit; cursor:pointer; color:var(--ink); transition:all .12s ease;
  }
  .option:hover{ border-color:var(--brass); }
  .option.selected{ border-color:var(--ink); background:#F5EBD6; font-weight:600; }
  .option.correct{ border-color:var(--sage); background:#DCE9D6; }
  .option.incorrect{ border-color:var(--rust); background:#F2D9D4; }
  .option:disabled{ cursor:default; }

  .feedback-banner{
    display:flex; align-items:center; gap:10px; padding:12px 14px; border-radius:8px;
    font-size:14px; font-weight:700; margin-bottom:16px;
  }
  .feedback-banner.pass{ background:#DCE9D6; color:#3C5533; }
  .feedback-banner.fail{ background:#F2D9D4; color:#7A2E23; }

  .final-question{ background:rgba(0,0,0,0.05); border-radius:10px; padding:16px; margin-top:6px; }

  .footer-note{ text-align:center; font-size:13px; color:var(--parchment); margin-top:18px; line-height:1.6; }
  .footer-note strong{ color:var(--brass-bright); }

  .complete-screen{ text-align:center; }
  .complete-screen .badge{
    width:90px; height:90px; margin:0 auto 16px; border-radius:50%; background:var(--sage);
    display:flex; align-items:center; justify-content:center; font-size:40px;
  }
  .program-complete .badge{ background:var(--brass); }
  #volunteer-form-hook{
    border:2px dashed var(--line); border-radius:10px; padding:22px; margin-top:18px;
    background:rgba(0,0,0,0.04); font-size:13px; color:#6B5A42; text-align:center;
  }

  .article-content{
    max-height:440px; overflow-y:auto; background:#fff; border:1px solid #D8C7A3;
    border-radius:10px; padding:18px 20px; margin-bottom:16px; font-size:14px; line-height:1.65;
  }
  .article-content h2{ font-family:'Rye', serif; font-size:22px; margin:0 0 4px; color:var(--ink); }
  .article-content h3{ font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:#6B5A42; margin:0 0 10px; font-weight:600; }
  .article-content h4{ font-size:17px; margin:18px 0 6px; color:var(--rust); font-family:'Rye', serif; font-weight:400; }
  .article-content p{ margin:0 0 12px; }
  .article-content ul, .article-content ol{ margin:0 0 12px; padding-left:22px; }
  .article-content li{ margin-bottom:6px; }
  .article-content blockquote{
    margin:12px 0; padding:10px 14px; border-left:4px solid var(--brass);
    background:rgba(176,141,87,0.08); font-style:italic; color:#4A3A28;
  }
  .article-content hr{ border:none; border-top:1px solid #E0D0AC; margin:18px 0; }
  .gate-status{ display:flex; flex-direction:column; gap:6px; margin-bottom:14px; font-size:13px; color:#6B5A42; }
  .gate-row{ transition:color .2s ease; }
  .gate-row.gate-done{ color:var(--sage); font-weight:700; }
  .gate-explainer{
    font-size:12.5px; color:#6B5A42; background:rgba(0,0,0,0.04); border-radius:8px;
    padding:10px 12px; margin-bottom:14px; line-height:1.5; font-style:italic;
  }
  .completion-disclaimer{
    text-align:left; font-size:14px; line-height:1.65; color:var(--ink); font-weight:500;
    background:#F2D9D4; border:1.5px solid var(--rust); border-radius:8px; padding:14px 16px; margin:16px 0;
  }
  .completion-disclaimer strong{ color:var(--rust); }
</style>
</head>
<body>
<div class="app">

  <div class="masthead">
    <div class="eyebrow">KHGN FIELD TRAINING · COMMUNITY ADVISORY TRACK</div>
    <h1>Level 2: Copyright & Terms of Use</h1>
    <a class="portal-link" href="https://khgn-inc.org/game-portal.html">&larr; Back to Game Portal</a>
    <div class="level-sub">Guided by The Teacher</div>
  </div>

  <div class="trail-wrap" id="trail-wrap"><div class="trail" id="trail"></div></div>
  <div id="stage"></div>

  <div class="footer-note">
    Kentucky History &amp; Genealogy Network, Inc. — Volunteer Field Training Program<br>
    Failing the Sheriff's final chance at any waypoint returns you to the start of this level.<br><br>
    <strong>This training is an internal educational orientation for KHGN volunteers only.</strong>
    It is not an accredited certification, professional credential, or license of any kind, and
    completion does not represent legal advice or KHGN's endorsement as an accrediting body.
    <br><br>
    <a href="#" onclick="resetProgress(); return false;" style="color:var(--brass-bright); text-decoration:underline; font-size:12px;">Reset this level's progress on this device</a>
  </div>
</div>

<script>
const TOTAL_STOPS = 12;
const LEVEL_ID = 2;
const LEVEL_TOPIC = "Copyright & Terms of Use";
const GUIDE_NAME = "The Teacher";
const GUIDE_ROLE = "Trail Guide";
</script>
</body>
</html>
